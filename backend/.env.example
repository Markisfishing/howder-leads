# 複製成 backend/.env 後修改。.env 不可以 commit（CLAUDE.md 第 8 節）

# development | test | production
ENV=development

# 開發用資料庫：執行 `uv run python -m scripts.dev_db` 會印出這一行該填的網址
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/howder

# 登入方式：dev = 用 X-Dev-User header 模擬（只能開發用）；entra = 公司 Microsoft 帳號
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# 第一次登入就給 admin 角色的帳號，逗號分隔
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# sandbox = 不會真的寄信；live 只能在 ENV=production 設定
MAIL_MODE=sandbox
# live 才需要（ADR 0005）：Entra 機密用戶端密碼、權杖快取加密金鑰
# 金鑰產生：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 換金鑰時把新金鑰放最前面、舊金鑰留在後面（逗號分隔）
ENTRA_CLIENT_SECRET=
MAIL_TOKEN_KEY=
# 真實寄信測試用的收件者白名單（M2-18）：逗號分隔，完整 email 或 @網域（只比對完整網域）
# 有設定時，名單外的收件者在建立草稿和寄出前都會被擋下；空白 = 不限制，正式上線才清空
# 測試時建議一起把 DAILY_SEND_LIMIT=2、SEND_PER_MINUTE=1
MAIL_ALLOWED_RECIPIENTS=

# 寄送限制：每人每天上限、每分鐘最多幾封、超過上限時隔天幾點開始寄（台灣時間）、幾天內寄過就不再寄
DAILY_SEND_LIMIT=50
SEND_PER_MINUTE=10
SEND_DAY_START_HOUR=9
RECENT_SEND_DAYS=14

# AI 寫信（ADR 0006）：local = 本機／內網的 OpenAI 相容 LLM（預設 Ollama）
# 公司 GPU 主機確認後，只改 LOCAL_LLM_BASE_URL 與 LOCAL_LLM_MODEL
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
LLM_CONCURRENCY=2
# LLM_PROVIDER=claude 時才需要（保留的切換選項，ADR 0006）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# MLE function 呼叫 POST /api/v1/imports/api 時帶在 X-API-Key header
IMPORT_API_KEY=change-me

# 認領後鎖定天數
LOCK_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
